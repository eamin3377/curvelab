run = "sh -c 'cd frontend && npm install && npm run build && cp -r dist/* ../backend/static/ && cd ../backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 3000'"
entrypoint = "backend/app/main.py"
modules = ["python3-v12", "nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "cd frontend && npm install && npm run build && cp -r dist/* ../backend/static/ && cd ../backend && python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT"]
deploymentTarget = "cloudrun"
